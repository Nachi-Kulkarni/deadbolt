{
  "manifest_version": 3,
  "name": "Deadbolt",
  "description": "Enforces the websites and exceptions set in the Deadbolt app.",
  "version": "1.0.0",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "webNavigation", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "background": { "service_worker": "sw.js", "scripts": ["matcher.js", "sw.js"] },
  "action": { "default_popup": "popup.html", "default_title": "Deadbolt" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_end" }
  ],
  "web_accessible_resources": [],
  "browser_specific_settings": { "gecko": { "id": "blocker@deadbolt.local", "strict_min_version": "115.0" } }
}
